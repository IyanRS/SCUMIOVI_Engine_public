{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Engine",
      "type": "shell",
      "command": ".\\build.bat SCUMIOVI_Engine\\SCUMIOVI_Engine.vcxproj /p:Configuration=Debug /p:Platform=x64 /m",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Compile Game",
      "type": "shell",
      "command": ".\\build.bat SCUMIOVI_Game\\SCUMIOVI_Game.vcxproj /p:Configuration=Debug /p:Platform=x64 /m",
      "group": "build",
      "dependsOn": ["Compile Engine"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Compile All",
      "type": "shell",
      "command": ".\\build.bat SCUMIOVI_Engine.sln /p:Configuration=Debug /p:Platform=x64 /m",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Game",
      "type": "shell",
      "command": "Start-Process -FilePath \"${workspaceFolder}\\x64\\Debug\\SCUMIOVI_Game.exe\" -WorkingDirectory \"${workspaceFolder}\\SCUMIOVI_Engine\"",
      "dependsOn": ["Compile All"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": ".\\build_tests.bat",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}