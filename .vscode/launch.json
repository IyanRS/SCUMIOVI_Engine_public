{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch SCUMIOVI Game (Debug x64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/x64/Debug/SCUMIOVI_Game.exe",
            "args": [],
            "cwd": "${workspaceFolder}/SCUMIOVI_Engine",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/SDL3/lib/x64;${workspaceFolder}/SDL3_image/lib/x64;${workspaceFolder}/SDL3_ttf/lib/x64;${env:PATH}"
                }
            ]
        }
    ]
}