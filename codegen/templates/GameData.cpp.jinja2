#include "../../SCUMIOVI_Engine/ScriptLoader.hpp"
#include "../../SCUMIOVI_Engine/Door.hpp"
#include "../../SCUMIOVI_Engine/Item.hpp"
#include "../../SCUMIOVI_Engine/DialogueNode.hpp"

void ScriptLoader::loadAndRunGame() {
    // --- Animations ---
    {% for a in animations %}
    {% if a.mirror_of %}
    Animation {{ a.name }} = {{ a.mirror_of }}.getMirrored("{{ a.name }}");
    {% else %}
    Animation {{ a.name }} = Animation(
        "{{ a.name }}",
        "{{ a.src }}",
        {{ parse_vector(a.pos, type_hint="int") }},
        {{ parse_vector(a.size, type_hint="int") }},
        {{ a.frames }}
    );
    {% endif %}
    {% endfor %}

    // --- Textures for objects ---
    {% for o in objects %}
    Texture {{ o.id }}Texture = Texture(
        "{{ o.id }}",
        "{{ o.image }}"{{ ',\n' + 
           ('\t\t' + parse_vector(o.offset, type_hint="int") + ',\n'
          + '\t\t' + parse_vector(o.size, type_hint="int") if o.size else 'Vector2<int>(-1,-1)' + '\n')
            if o.offset else ''}}
    );
    {% if o.type == 'item' %}
    Texture {{ o.id }}ItemTexture = Texture(
        "{{ o.id }}_item",
        "{{ o.itemImage }}"
    );
    {% endif %}
    {% endfor %}

    // --- Text formats ---
    {% for t in text_formats %}
    int {{ t.format_id }}FormatColor[] = { {{ t.color[0] }}, {{ t.color[1] }}, {{ t.color[2] }}, 0xff };
    Text {{ t.format_id }}Format = Text(
        "",
        {{ t.size }},
        {{ t.format_id }}FormatColor,
        {{ "true" if t.outline else "false" }},
        {{ "TEXT_ON_BOTTOM" if t.position == 'bottom' else "TEXT_CENTERED" if t.position == 'center' else "TEXT_ON_TOP" }},
        {{ "true" if t.shadow else "false" }}
    );
    {% endfor %}

    // --- Players ---
    {% for p in players %}
    auto {{ p.id }} = std::make_shared<Player>("{{ p.id }}", Vector2<>(0,0));
    {% for anim in p.anims %}
    {{ p.id }}->addAnimation(&{{ anim }});
    {% endfor %}

    Texture idleTexture = {{p.animationMoveRight}}.getFrames()[0];
    idleTexture.setName("idle");
    {{ p.id }}->addTexture(&idleTexture);
    {{ p.id }}->setTexture("idle");

    {{ p.id }}->setMovementAnimations(
        {{ '&' + p.animationMoveRight if p.animationMoveRight else 'nullptr' }},
        {{ '&' + p.animationMoveLeft if p.animationMoveLeft else 'nullptr' }},
        {{ '&' + p.animationMoveUp if p.animationMoveUp else 'nullptr' }},
        {{ '&' + p.animationMoveDown if p.animationMoveDown else 'nullptr' }},
        {{ '&' + p.animationIdleRight if p.animationIdleRight else 'nullptr' }},
        {{ '&' + p.animationIdleLeft if p.animationIdleLeft else 'nullptr' }},
        {{ '&' + p.animationIdleUp if p.animationIdleUp else 'nullptr' }},
        {{ '&' + p.animationIdleDown if p.animationIdleDown else 'nullptr' }}
    );
    {{ p.id }}->setTextFormat({{ p.text_format }}Format);

    game.addPlayer({{ p.id }});
    {% endfor %}

    // --- Scenes ---
    {% for s in scenes %}
    Scene {{ s.name }};
    // Walkable area
    WalkableArea {{ s.name }}Walk = WalkableArea({
        {% for pt in s.walk %}
        {{ parse_vector(pt, type_hint='') }}, 
        {% endfor %}
    });
    {{ s.name }}.setWalkableArea(&{{ s.name }}Walk);

    // Backgrounds
    {% for bg in s.bg %}
    auto {{ s.name }}Bg = {{ s.name }}.addBackground(
        {{ s.name }}, "{{ bg.tex }}", {{ parse_vector(bg.pos, type_hint='int') }}
    );
    {% endfor %}

    // Objects
    {% set ns = namespace(isItem=false) %}
    {% for o in s.objects %}
    {% for obj in objects %}
    {% if o.id == obj.id and obj.type == 'item' %}
        {% set ns.isItem = True %}
    {% endif %}
    {% endfor %}
    {% if ns.isItem == True %}
    auto {{ o.id }} = std::make_shared<Item>(
        "{{ o.id }}",
        {{ parse_vector(o.pos, type_hint='') }},
        &{{ o.id }}Texture,
        &{{ o.id }}ItemTexture
    );
    {% set ns.isItem = False %}
    {% else %}
    auto {{ o.id }} = std::make_shared<GameObject>(
        "{{ o.id }}",
        {{ parse_vector(o.pos,type_hint='') }},
        Vector2<>(-1,-1),
        &{{ o.id }}Texture
    );
    {% endif %}

    //{{ s.name }}.addGameObject({{ o.id }});
    {{ o.id }}->moveToScene({{ s.name }});
    {{ o.id }}->setLayer({{ o.layer }});
    {% endfor %}

    {% for obj in objects %}
    {% if obj.text_format %}
    {{obj.id}}->setTextFormat({{obj.text_format}}Format);
    {% endif %}
    {% endfor %}

    // Players
    {% if s.player %}
    {{ s.player.id }}->moveToScene({{ s.name }});
    {{ s.player.id }}->setPosition({{ parse_vector(s.player.pos, type_hint='') }});
    {% endif %}

    {% endfor %}

    // --- Startup configuration ---
    {% if config.main_character %}
    game.setCurrentPlayer({{ config.main_character }});
    {{ config.main_character }}->setVerb("walk"); // TODO: custom default verb?
    {% endif %}
    game.changeScene(*(std::dynamic_pointer_cast<GameObject>({{ config.main_character }})->getScene()));
    {{ config.main_character }}->moveToScene({{ config.main_scene }});


    // TODO: Custom UI
    int blackColor[] = { 0x00, 0x00, 0x00, 0xff };
	Texture blackImage = Texture("black", blackColor);
	auto uiBackground = std::make_shared<GameObject>("uiBackground", Vector2<>(0, 144), Vector2<>(640, 56), &blackImage);

	game.getUI().createLayout("inventory");
	game.getUI().setLayout("inventory");

	game.getUI().getLayout("inventory").addUIElement(uiBackground);
    int verbBackgroundColor[] = { 20, 0, 20, 0xff };
	Texture verbBackground = Texture("white", verbBackgroundColor);

	game.getUI().getLayout("inventory").createVerbsMatrix(Vector2<>(2, 154), {

		{&Verb::giveVerb, &Verb::pickupVerb, &Verb::useVerb},
		{&Verb::openVerb, &Verb::lookAtVerb, &Verb::pushVerb},
		{&Verb::closeVerb, &Verb::talkVerb, &Verb::pullVerb} },
		
		&verbBackground);

	Event emptyEvent = Event();

	game.getUI().getLayout("inventory").createInventoryMatrix(Vector2<>(150, 154), 4, 2, &verbBackground, emptyEvent);

	auto uiCurrentVerbInfo = std::make_shared<GameObject>("uiCurrentVerbInfo", Vector2<>(160, 148), Vector2<>());
	int color[4] = { 125, 44, 125, 0xff };
	Text currentInfoText = Text("Test info", 11, color, false, TEXT_CENTERED);
	uiCurrentVerbInfo->setTextOver(currentInfoText);
	uiCurrentVerbInfo->setTextFormat(currentInfoText);
	game.getUI().getLayout("inventory").addUIElement(uiCurrentVerbInfo);

    // Custom cursor
    {% if config.cursor %}
    Texture customCursorTexture = Texture("", "{{ config.cursor }}");
	game.setCustomCursor(customCursorTexture, Vector2<>(-1, -1));
    {% endif %}

    {% if config.default_verb %}
	game.setDefaultVerb("{{ config.default_verb }}");
    {% else %}
    game.setDefaultVerb("walk");
    {% endif %}

	game.getUI().createLayout("dialogue");
	game.getUI().getLayout("dialogue").addUIElement(uiBackground);
    game.getUI().setDialogueLayout(&game.getUI().getLayout("dialogue"));
    game.getUI().setAfterDialogueLayout(&game.getUI().getLayout("inventory"));

    // ==========================================
    //  Auto-generated dialogue code
    // ==========================================

    {% macro cpp_string(s) -%}
    {{ s
    | replace('"', '\\"')
    }}
    {%- endmacro %}

    {% for dialogue_map in dialogues %}
    {% for label, dlg in dialogue_map.items() %}
        // --- DialogueNode for "{{ label }}" ---

    DialogueNode {{ label }}Node = DialogueNode(Event([&stan, &{{ label }}Node](EventInfo e) {
        {# 1) One .say() per line, each nesting an Event #}
        {% for line in dlg.lines if line.text is not none %}
        {{ ' ' * (4 + 4 * loop.index0) }}{% if line.speaker == 'player' %}e.game.getCurrentPlayer()->{% else %}{{ line.speaker }}->{% endif %}say(
            "{{ cpp_string(line.text) }}",
            {{ line.delay if line.delay is not none else 0 }},
            Event([&{{ label }}Node](EventInfo e) {
        {% endfor %}
        {# 2) After last line: either injected script or showOptions() #}
        {% if dlg.lines[-1].action %}
        {{ ' ' * (4 + 4 * dlg.lines|length) }}// Content of script imported from {{ dlg.lines[-1].action }}
        {% else %}
        {{ ' ' * (4 + 4 * dlg.lines|length) }}{{ label }}Node.showOptions();
        {% endif %}
        {# 3) Close each inner say/Event, innermost first #}
        {% set n = dlg.lines|selectattr("text")|list|length %}
        {% for i in range(n-1, -1, -1) %}
        {{ ' ' * (4 + 4 * i) }}}));  
        {% endfor %}
    }));  {# closes outer Event and DialogueNode ctor #}


    {% endfor %}

    {# 4) Now define DialogueOption objects #}
    {% for label, dlg in dialogue_map.items() %}
        {% for opt in dlg.options %}
    DialogueOption {{ label }}NodeOption{{ loop.index }} = DialogueOption(
        "{{ cpp_string(opt.text) }}",
        &{{ opt.target }}Node
    );
        {% endfor %}
    {% endfor %}

    {# 5) Finally wire up setOptions() calls #}
    {% for label, dlg in dialogue_map.items() %}
        {% if dlg.options %}
    {{ label }}Node.setOptions({ {% for opt in dlg.options %}{{ label }}NodeOption{{ loop.index }}{{ ", " if not loop.last }}{% endfor %} });
        {% endif %}
    {% endfor %}

    {% endfor %}

    {% for i in interactions %}
    {% if i.other_object_id %}
    {{ i.object_id }}->addVerbInteraction(*game.getVerb("{{ i.verb }}"), "{{ i.other_object_id }}", Event([{{ i.vars|join(', ') }}](EventInfo e) {
{{ i.script }}
    }));
    {% else %}
    {{ i.object_id }}->addVerbInteraction(*game.getVerb("{{ i.verb }}"), Event([{{ i.vars|join(', ') }}](EventInfo e) {
{{ i.script }}
    }));
    {% endif %}
    {% endfor %}

    game.bindLeftClickToVerb(&Verb::selectedVerb);
    game.bindRightClickToVerb(&Verb::defaultVerb);

    game.startGame();

}
