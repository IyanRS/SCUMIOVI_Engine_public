// ==========================================
//  Auto-generated file. Do not edit by hand.
// ==========================================

#include "ScriptLoader.hpp"
#include "EngineAPI.hpp"
#include "Interactions/interactions.h"
#include <memory>

{% macro cpp_string(s) -%}
{{ s
| replace('"', '\\"')
}}
{%- endmacro %}

void ScriptLoader::loadGame(Game& game) {

    // --- Verbs ---
    // The engine only provides the "any"/"selected" protocol verbs; every
    // game-facing verb (walk, use, give, ...) comes from game/Verbs.csv.
    {% set verb_ids = verbs | map(attribute='id') | list %}
    {% for v in verbs %}
    game.{{ v.member_name }} = std::make_shared<Verb>("{{ v.id }}", "{{ cpp_string(v.displayName) }}"
        {%- if v.syntax %}, VerbSyntax({ {% for s in v.syntax %}"{{ cpp_string(s) }}"{{ ", " if not loop.last }}{% endfor %} }){% if v.requires_selected %}, true{% endif %}{% endif %});
    game.addVerb(game.{{ v.member_name }});
    {% if v.check_examine_text %}
    game.{{ v.member_name }}->setDefaultEvent(Event([](EventInfo e) {
        auto* go = dynamic_cast<GameObject*>(&e.interactable);
        if (go && !go->getExamineText().empty()) {
            e.player.say(tr(go->getExamineText()));
        } else {
            e.player.say(tr("{{ cpp_string(v.default_message) }}"));
        }
    }));
    {% elif v.default_message %}
    game.{{ v.member_name }}->setDefaultEvent(Event([](EventInfo e) {
        e.player.say(tr("{{ cpp_string(v.default_message) }}"));
    }));
    {% endif %}
    {% endfor %}

    // Engine-provided mechanics (click-to-walk pathfinding, give-removes-item)
    // are wired up here, now that the verbs they attach to exist.
    {% if 'walk' in verb_ids %}
    game.walkVerb->setDefaultEvent(moveToEvent);
    {% endif %}
    {% if 'give' in verb_ids %}
    game.giveVerb->setAfterActualEvent(afterGiveEvent);
    {% endif %}

    // --- Animations ---
    {% for a in animations %}
    {% if a.mirror_of %}
    auto {{ a.name }} = {{ a.mirror_of }}->getMirrored("{{ a.name }}");
    {% else %}
    auto {{ a.name }} = std::make_shared<Animation>(
        "{{ a.name }}",
        "{{ a.src }}",
        {{ parse_vector(a.pos, type_hint="int") }},
        {{ parse_vector(a.size, type_hint="int") }},
        {{ a.frames }}
    );
    {% endif %}
    {% endfor %}

    // --- Textures for objects ---
    {% for o in objects %}
    auto {{ o.id }}Texture = std::make_shared<Texture>(
        "{{ o.id }}",
        "{{ o.image }}"{{ ',\n' + 
           ('\t\t' + parse_vector(o.offset, type_hint="int") + ',\n'
          + '\t\t' + parse_vector(o.size, type_hint="int") if o.size else 'Vector2<int>(-1,-1)' + '\n')
            if o.offset else ''}}
    );
    {% if o.type == 'item' %}
    auto {{ o.id }}ItemTexture = std::make_shared<Texture>(
        "{{ o.id }}_item",
        "{{ o.itemImage }}"
    );
    {% endif %}
    {% endfor %}

    // --- Text formats ---
    {% for t in text_formats %}
    int {{ t.format_id }}FormatColor[] = { {{ t.color[0] }}, {{ t.color[1] }}, {{ t.color[2] }}, 0xff };
    Text {{ t.format_id }}Format = Text(
        "",
        {{ t.size }},
        {{ t.format_id }}FormatColor,
        {{ "true" if t.outline else "false" }},
        {{ "TEXT_ON_BOTTOM" if t.position == 'bottom' else "TEXT_CENTERED" if t.position == 'center' else "TEXT_ON_TOP" }},
        {{ "true" if t.shadow else "false" }}
    );
    {% endfor %}

    // --- Players ---
    {% for p in players %}
    auto {{ p.id }} = std::make_shared<Player>("{{ p.id }}", Vector2<>(0.0f, 0.0f));
    {% for anim in p.anims %}
    {{ p.id }}->addAnimation({{ anim }});
    {% endfor %}

    auto {{ p.id }}IdleTexture = std::make_shared<Texture>({{p.animationMoveRight}}->getFrames()[0]);
    {{ p.id }}IdleTexture->setName("idle");
    {{ p.id }}->addTexture({{ p.id }}IdleTexture);
    {{ p.id }}->setTexture("idle");

    {{ p.id }}->setMovementAnimations(
        {{ p.animationMoveRight if p.animationMoveRight else 'nullptr' }},
        {{ p.animationMoveLeft if p.animationMoveLeft else 'nullptr' }},
        {{ p.animationMoveUp if p.animationMoveUp else 'nullptr' }},
        {{ p.animationMoveDown if p.animationMoveDown else 'nullptr' }},
        {{ p.animationIdleRight if p.animationIdleRight else 'nullptr' }},
        {{ p.animationIdleLeft if p.animationIdleLeft else 'nullptr' }},
        {{ p.animationIdleUp if p.animationIdleUp else 'nullptr' }},
        {{ p.animationIdleDown if p.animationIdleDown else 'nullptr' }}
    );
    {{ p.id }}->setTextFormat({{ p.text_format }}Format);

    game.addPlayer({{ p.id }});
    {% endfor %}

    // --- Scenes ---
    {% for s in scenes %}
    auto {{ s.name }} = std::make_shared<Scene>();
    game.registerScene("{{ s.name }}", {{ s.name }});
    // Walkable area
    auto {{ s.name }}Walk = std::make_unique<WalkableArea>(std::initializer_list<Vector2<>>{
        {% for pt in s.walk %}
        {{ parse_vector(pt, type_hint='') }}, 
        {% endfor %}
    });
    {{ s.name }}->setWalkableArea(std::move({{ s.name }}Walk));

    // Backgrounds
    {% for bg in s.bg %}
    auto {{ s.name }}Bg = {{ s.name }}->addBackground(
        "{{ bg.tex }}", {{ parse_vector(bg.pos, type_hint='int') }}
    );
    {% endfor %}

    // Objects
    {% set ns = namespace(isItem=false) %}
    {% for o in s.objects %}
    {% for obj in objects %}
    {% if o.id == obj.id and obj.type == 'item' %}
        {% set ns.isItem = True %}
    {% endif %}
    {% endfor %}
    {% if ns.isItem == True %}
    auto {{ o.id }} = std::make_shared<Item>(
        "{{ o.id }}",
        {{ parse_vector(o.pos, type_hint='') }},
        {{ o.id }}Texture,
        {{ o.id }}ItemTexture
    );
    {% set ns.isItem = False %}
    {% else %}
    auto {{ o.id }} = std::make_shared<GameObject>(
        "{{ o.id }}",
        {{ parse_vector(o.pos,type_hint='') }},
        Vector2<>(-1.0f, -1.0f),
        {{ o.id }}Texture
    );
    {% endif %}

    {{ o.id }}->moveToScene({{ s.name }});
    {{ o.id }}->setLayer({{ o.layer }});
    {% endfor %}

    {% set scene_object_ids = s.objects | map(attribute='id') | list %}
    {% for obj in objects %}
    {% if obj.id in scene_object_ids %}
    {% if obj.text_format %}
    {{obj.id}}->setTextFormat({{obj.text_format}}Format);
    {% endif %}
    {% if obj.examine_text %}
    {{obj.id}}->setExamineText("{{ cpp_string(obj.examine_text) }}");
    {% endif %}
    {% endif %}
    {% endfor %}

    // Players
    {% if s.player %}
    {{ s.player.id }}->moveToScene({{ s.name }});
    {{ s.player.id }}->setPosition({{ parse_vector(s.player.pos, type_hint='') }});
    {% endif %}

    {% endfor %}

    // --- Startup configuration ---
    {% if config.main_character %}
    game.setCurrentPlayer({{ config.main_character }});
    {{ config.main_character }}->setVerb("walk");
    {% endif %}
    
    if (game.getCurrentPlayer() && game.getCurrentPlayer()->getScene()) {
        game.changeScene(game.getCurrentPlayer()->getScene());
    }
    
    {% if config.main_character and config.main_scene %}
    {{ config.main_character }}->moveToScene({{ config.main_scene }});
    {% endif %}

    // --- UI Setup ---
    // Layouts (backgrounds, verb grid, inventory grid, verb-info label, pause
    // menu) are authored as data under assets/ui/*.json and loaded here.
    UILoader::loadLayoutsFromDirectory(game, ResourceManager::getUIDirectory());
    game.getUI().setLayout("inventory");

    // --- Key bindings ---
    // What each key does (e.g. Escape opens the pause menu) is game data too;
    // see assets/keybindings.json and KeyBindings.
    game.getInputManager().getKeyBindings().loadFromFile(ResourceManager::getKeybindingsPath());

    {% if config.window_title %}
    game.getRenderer().setWindowTitle("{{ cpp_string(config.window_title) }}");
    {% endif %}

    // Custom cursor
    {% if config.cursor %}
    auto customCursorTexture = std::make_shared<Texture>("", "{{ config.cursor }}");
	game.setCustomCursor(customCursorTexture, Vector2<>(-1.0f, -1.0f));
    {% endif %}

    {% if config.default_verb %}
	game.setDefaultVerb("{{ config.default_verb }}");
    {% else %}
    game.setDefaultVerb("walk");
    {% endif %}

    game.getUI().setDialogueLayout(&game.getUI().getLayout("dialogue"));
    game.getUI().setAfterDialogueLayout(&game.getUI().getLayout("inventory"));

    // ==========================================
    //  Auto-generated dialogue code
    // ==========================================

    {% for dialogue_map in dialogues %}
    {% for label, dlg in dialogue_map.items() %}
        // --- DialogueNode for "{{ label }}" ---

    auto {{ label }}Node = std::make_shared<DialogueNode>();
    {{ label }}Node->setDialogueEvent(Event(std::function<void(EventInfo)>([=](EventInfo e) {
        {% for line in dlg.lines if line.text is not none %}
        {{ ' ' * (4 + 4 * loop.index0) }}{% if line.speaker == 'player' %}e.game.getCurrentPlayer()->{% else %}{{ line.speaker }}->{% endif %}say(
            tr("{{ cpp_string(line.text) }}"),
            {{ line.delay if line.delay is not none else 0.0 }}f,
            Event(std::function<void(EventInfo)>([=](EventInfo e) {
        {% endfor %}
        {% if dlg.lines[-1].action %}
            {{ ' ' * (4 + 4 * dlg.lines|length) }}e.game.scriptEvent("{{ dlg.lines[-1].action }}").execute(e);
        {% else %}
            {{ ' ' * (4 + 4 * dlg.lines|length) }}{{ label }}Node->showOptions();
        {% endif %}
        {% set n = dlg.lines|selectattr("text")|list|length %}
        {% for i in range(n-1, -1, -1) %}
        {{ ' ' * (4 + 4 * i) }} })));  
        {% endfor %}
    })));

    {% endfor %}

    {% for label, dlg in dialogue_map.items() %}
        {% for opt in dlg.options %}
    auto {{ label }}NodeOption{{ loop.index }} = std::make_shared<DialogueOption>(
        "{{ cpp_string(opt.text) }}",
        {{ opt.target }}Node
    );
        {% if opt.condition %}
            {% if opt.condition.type == 'flag' %}
    {{ label }}NodeOption{{ loop.index }}->setCondition([]() { return Game::getInstance().getGameState().getFlag("{{ opt.condition.name }}"); });
            {% elif opt.condition.type == 'notflag' %}
    {{ label }}NodeOption{{ loop.index }}->setCondition([]() { return !Game::getInstance().getGameState().getFlag("{{ opt.condition.name }}"); });
            {% elif opt.condition.type == 'counter' %}
    {{ label }}NodeOption{{ loop.index }}->setCondition([]() { return Game::getInstance().getGameState().getCounter("{{ opt.condition.name }}") {{ opt.condition.op }} {{ opt.condition.value }}; });
            {% endif %}
        {% endif %}
        {% endfor %}
    {% endfor %}

    {% for label, dlg in dialogue_map.items() %}
        {% if dlg.options %}
    {{ label }}Node->setOptions({ {% for opt in dlg.options %}{{ label }}NodeOption{{ loop.index }}{{ ", " if not loop.last }}{% endfor %} });
        {% endif %}
    {% endfor %}

    {% endfor %}

    // --- Register named interaction scripts ---
    {% for name in script_names %}
    game.registerScript("{{ name }}", {{ name }});
    {% endfor %}

    {% for i in interactions %}
    {% if i.function_name %}
    {% if i.other_object_id %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), "{{ i.other_object_id }}", game.scriptEvent("{{ i.function_name }}"));
    {% else %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), game.scriptEvent("{{ i.function_name }}"));
    {% endif %}
    {% else %}
    {% if i.other_object_id %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), "{{ i.other_object_id }}", Event([=](EventInfo e) {
{{ i.script }}
    }));
    {% else %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), Event([=](EventInfo e) {
{{ i.script }}
    }));
    {% endif %}
    {% endif %}
    {% endfor %}

    // --- Item combinations ---
    {% for combo in combinations %}
    game.addCombination("{{ combo.item }}", "{{ combo.target }}", game.scriptEvent("{{ combo.function_name }}"));
    {% endfor %}

    game.bindLeftClickToVerb(game.selectedVerb);
    game.bindRightClickToVerb(game.getDefaultVerb());

    // --- Intro cutscene ---
    // Optional: assets/cutscenes/intro.json is authored data, not engine or
    // game logic; skip silently if the game doesn't ship one.
    if (CutsceneLoader::loadAndRegister(game, ResourceManager::getCutscenesDirectory() + "intro.json", "introCutscene")) {
        game.scriptEvent("introCutscene").execute();
    }

    }
