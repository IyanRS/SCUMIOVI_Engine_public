// ==========================================
//  Auto-generated file. Do not edit by hand.
// ==========================================

#include "ScriptLoader.hpp"
#include "EngineAPI.hpp"
#include <memory>

void ScriptLoader::loadGame(Game& game) {

    // --- Animations ---
    {% for a in animations %}
    {% if a.mirror_of %}
    auto {{ a.name }} = {{ a.mirror_of }}->getMirrored("{{ a.name }}");
    {% else %}
    auto {{ a.name }} = std::make_shared<Animation>(
        "{{ a.name }}",
        "{{ a.src }}",
        {{ parse_vector(a.pos, type_hint="int") }},
        {{ parse_vector(a.size, type_hint="int") }},
        {{ a.frames }}
    );
    {% endif %}
    {% endfor %}

    // --- Textures for objects ---
    {% for o in objects %}
    auto {{ o.id }}Texture = std::make_shared<Texture>(
        "{{ o.id }}",
        "{{ o.image }}"{{ ',\n' + 
           ('\t\t' + parse_vector(o.offset, type_hint="int") + ',\n'
          + '\t\t' + parse_vector(o.size, type_hint="int") if o.size else 'Vector2<int>(-1,-1)' + '\n')
            if o.offset else ''}}
    );
    {% if o.type == 'item' %}
    auto {{ o.id }}ItemTexture = std::make_shared<Texture>(
        "{{ o.id }}_item",
        "{{ o.itemImage }}"
    );
    {% endif %}
    {% endfor %}

    // --- Text formats ---
    {% for t in text_formats %}
    int {{ t.format_id }}FormatColor[] = { {{ t.color[0] }}, {{ t.color[1] }}, {{ t.color[2] }}, 0xff };
    Text {{ t.format_id }}Format = Text(
        "",
        {{ t.size }},
        {{ t.format_id }}FormatColor,
        {{ "true" if t.outline else "false" }},
        {{ "TEXT_ON_BOTTOM" if t.position == 'bottom' else "TEXT_CENTERED" if t.position == 'center' else "TEXT_ON_TOP" }},
        {{ "true" if t.shadow else "false" }}
    );
    {% endfor %}

    // --- Players ---
    {% for p in players %}
    auto {{ p.id }} = std::make_shared<Player>("{{ p.id }}", Vector2<>(0.0f, 0.0f));
    {% for anim in p.anims %}
    {{ p.id }}->addAnimation({{ anim }});
    {% endfor %}

    auto idleTexture = std::make_shared<Texture>({{p.animationMoveRight}}->getFrames()[0]);
    idleTexture->setName("idle");
    {{ p.id }}->addTexture(idleTexture);
    {{ p.id }}->setTexture("idle");

    {{ p.id }}->setMovementAnimations(
        {{ p.animationMoveRight if p.animationMoveRight else 'nullptr' }},
        {{ p.animationMoveLeft if p.animationMoveLeft else 'nullptr' }},
        {{ p.animationMoveUp if p.animationMoveUp else 'nullptr' }},
        {{ p.animationMoveDown if p.animationMoveDown else 'nullptr' }},
        {{ p.animationIdleRight if p.animationIdleRight else 'nullptr' }},
        {{ p.animationIdleLeft if p.animationIdleLeft else 'nullptr' }},
        {{ p.animationIdleUp if p.animationIdleUp else 'nullptr' }},
        {{ p.animationIdleDown if p.animationIdleDown else 'nullptr' }}
    );
    {{ p.id }}->setTextFormat({{ p.text_format }}Format);

    game.addPlayer({{ p.id }});
    {% endfor %}

    // --- Scenes ---
    {% for s in scenes %}
    auto {{ s.name }} = std::make_shared<Scene>();
    // Walkable area
    auto {{ s.name }}Walk = std::make_unique<WalkableArea>(std::initializer_list<Vector2<>>{
        {% for pt in s.walk %}
        {{ parse_vector(pt, type_hint='') }}, 
        {% endfor %}
    });
    {{ s.name }}->setWalkableArea(std::move({{ s.name }}Walk));

    // Backgrounds
    {% for bg in s.bg %}
    auto {{ s.name }}Bg = {{ s.name }}->addBackground(
        "{{ bg.tex }}", {{ parse_vector(bg.pos, type_hint='int') }}
    );
    {% endfor %}

    // Objects
    {% set ns = namespace(isItem=false) %}
    {% for o in s.objects %}
    {% for obj in objects %}
    {% if o.id == obj.id and obj.type == 'item' %}
        {% set ns.isItem = True %}
    {% endif %}
    {% endfor %}
    {% if ns.isItem == True %}
    auto {{ o.id }} = std::make_shared<Item>(
        "{{ o.id }}",
        {{ parse_vector(o.pos, type_hint='') }},
        {{ o.id }}Texture,
        {{ o.id }}ItemTexture
    );
    {% set ns.isItem = False %}
    {% else %}
    auto {{ o.id }} = std::make_shared<GameObject>(
        "{{ o.id }}",
        {{ parse_vector(o.pos,type_hint='') }},
        Vector2<>(-1.0f, -1.0f),
        {{ o.id }}Texture
    );
    {% endif %}

    {{ o.id }}->moveToScene({{ s.name }});
    {{ o.id }}->setLayer({{ o.layer }});
    {% endfor %}

    {% for obj in objects %}
    {% if obj.text_format %}
    {{obj.id}}->setTextFormat({{obj.text_format}}Format);
    {% endif %}
    {% endfor %}

    // Players
    {% if s.player %}
    {{ s.player.id }}->moveToScene({{ s.name }});
    {{ s.player.id }}->setPosition({{ parse_vector(s.player.pos, type_hint='') }});
    {% endif %}

    {% endfor %}

    // --- Startup configuration ---
    {% if config.main_character %}
    game.setCurrentPlayer({{ config.main_character }});
    {{ config.main_character }}->setVerb("walk");
    {% endif %}
    
    if (game.getCurrentPlayer() && game.getCurrentPlayer()->getScene()) {
        game.changeScene(game.getCurrentPlayer()->getScene());
    }
    
    {% if config.main_character and config.main_scene %}
    {{ config.main_character }}->moveToScene({{ config.main_scene }});
    {% endif %}

    // --- UI Setup ---
    int blackColor[] = { 0x00, 0x00, 0x00, 0xff };
	auto blackImage = std::make_shared<Texture>("black", blackColor);
	auto uiBackground = std::make_shared<GameObject>("uiBackground", Vector2<>(0.0f, 144.0f), Vector2<>(640.0f, 56.0f), blackImage);

	game.getUI().createLayout("inventory");
	game.getUI().setLayout("inventory");

	game.getUI().getLayout("inventory").addUIElement(uiBackground);
    int verbBackgroundColor[] = { 20, 0, 20, 0xff };
	auto verbBackground = std::make_shared<Texture>("white", verbBackgroundColor);

	game.getUI().getLayout("inventory").createVerbsMatrix(Vector2<>(2.0f, 154.0f), {
		{game.giveVerb, game.pickupVerb, game.useVerb},
		{game.openVerb, game.lookAtVerb, game.pushVerb},
		{game.closeVerb, game.talkVerb, game.pullVerb} },
		verbBackground);

	Event emptyEvent = Event();
	game.getUI().getLayout("inventory").createInventoryMatrix(Vector2<>(150.0f, 154.0f), 4, 2, verbBackground, emptyEvent);

	auto uiCurrentVerbInfo = std::make_shared<GameObject>("uiCurrentVerbInfo", Vector2<>(160.0f, 148.0f), Vector2<>(0.0f, 0.0f));
	int textColorUI[4] = { 125, 44, 125, 0xff };
	Text currentInfoText = Text("Test info", 11, textColorUI, false, TEXT_CENTERED);
	uiCurrentVerbInfo->setTextOver(currentInfoText);
	uiCurrentVerbInfo->setTextFormat(currentInfoText);
	game.getUI().getLayout("inventory").addUIElement(uiCurrentVerbInfo);

    // Custom cursor
    {% if config.cursor %}
    auto customCursorTexture = std::make_shared<Texture>("", "{{ config.cursor }}");
	game.setCustomCursor(customCursorTexture, Vector2<>(-1.0f, -1.0f));
    {% endif %}

    {% if config.default_verb %}
	game.setDefaultVerb("{{ config.default_verb }}");
    {% else %}
    game.setDefaultVerb("walk");
    {% endif %}

	game.getUI().createLayout("dialogue");
	game.getUI().getLayout("dialogue").addUIElement(uiBackground);
    game.getUI().setDialogueLayout(&game.getUI().getLayout("dialogue"));
    game.getUI().setAfterDialogueLayout(&game.getUI().getLayout("inventory"));

    // ==========================================
    //  Auto-generated dialogue code
    // ==========================================

    {% macro cpp_string(s) -%}
    {{ s
    | replace('"', '\\"')
    }}
    {%- endmacro %}

    {% for dialogue_map in dialogues %}
    {% for label, dlg in dialogue_map.items() %}
        // --- DialogueNode for "{{ label }}" ---

    std::shared_ptr<DialogueNode> {{ label }}Node;
    {{ label }}Node = std::make_shared<DialogueNode>(Event(std::function<void(EventInfo)>([&](EventInfo e) {
        {% for line in dlg.lines if line.text is not none %}
        {{ ' ' * (4 + 4 * loop.index0) }}{% if line.speaker == 'player' %}e.game.getCurrentPlayer()->{% else %}{{ line.speaker }}->{% endif %}say(
            "{{ cpp_string(line.text) }}",
            {{ line.delay if line.delay is not none else 0.0 }},
            Event(std::function<void(EventInfo)>([&](EventInfo e) {
        {% endfor %}
        {% if dlg.lines[-1].action %}
        {{ ' ' * (4 + 4 * dlg.lines|length) }}// Action: {{ dlg.lines[-1].action }}
        {% else %}
        {{ ' ' * (4 + 4 * dlg.lines|length) }}{{ label }}Node->showOptions();
        {% endif %}
        {% set n = dlg.lines|selectattr("text")|list|length %}
        {% for i in range(n-1, -1, -1) %}
        {{ ' ' * (4 + 4 * i) }} })));  
        {% endfor %}
    })));

    {% endfor %}

    {% for label, dlg in dialogue_map.items() %}
        {% for opt in dlg.options %}
    auto {{ label }}NodeOption{{ loop.index }} = std::make_shared<DialogueOption>(
        "{{ cpp_string(opt.text) }}",
        {{ opt.target }}Node
    );
        {% endfor %}
    {% endfor %}

    {% for label, dlg in dialogue_map.items() %}
        {% if dlg.options %}
    {{ label }}Node->setOptions({ {% for opt in dlg.options %}{{ label }}NodeOption{{ loop.index }}{{ ", " if not loop.last }}{% endfor %} });
        {% endif %}
    {% endfor %}

    {% endfor %}

    {% for i in interactions %}
    {% if i.other_object_id %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), "{{ i.other_object_id }}", Event([&](EventInfo e) {
{{ i.script }}
    }));
    {% else %}
    {{ i.object_id }}->addVerbInteraction(game.getVerb("{{ i.verb }}"), Event([&](EventInfo e) {
{{ i.script }}
    }));
    {% endif %}
    {% endfor %}

    game.bindLeftClickToVerb(game.selectedVerb);
    game.bindRightClickToVerb(game.getDefaultVerb());

    }
